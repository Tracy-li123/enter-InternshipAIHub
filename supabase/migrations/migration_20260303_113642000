-- 创建岗位分类表
CREATE TABLE IF NOT EXISTS job_categories (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name TEXT NOT NULL,
  user_id TEXT DEFAULT 'default_user',
  display_order INTEGER NOT NULL DEFAULT 0,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 创建岗位信息表
CREATE TABLE IF NOT EXISTS jobs (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  title TEXT NOT NULL,
  company TEXT NOT NULL,
  description TEXT,
  source_url TEXT,
  location TEXT,
  category_id UUID REFERENCES job_categories(id) ON DELETE SET NULL,
  published_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  scraped_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 创建用户岗位状态表
CREATE TABLE IF NOT EXISTS user_job_status (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  job_id UUID REFERENCES jobs(id) ON DELETE CASCADE NOT NULL,
  user_id TEXT DEFAULT 'default_user',
  status TEXT NOT NULL DEFAULT 'pending',
  notes TEXT,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  UNIQUE(job_id, user_id)
);

-- 创建AI模拟面试会话表
CREATE TABLE IF NOT EXISTS mock_interview_sessions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  job_id UUID REFERENCES jobs(id) ON DELETE CASCADE NOT NULL,
  user_id TEXT DEFAULT 'default_user',
  conversation_history JSONB DEFAULT '[]'::jsonb,
  feedback_summary TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 启用 RLS
ALTER TABLE job_categories ENABLE ROW LEVEL SECURITY;
ALTER TABLE jobs ENABLE ROW LEVEL SECURITY;
ALTER TABLE user_job_status ENABLE ROW LEVEL SECURITY;
ALTER TABLE mock_interview_sessions ENABLE ROW LEVEL SECURITY;

-- 创建 RLS 策略（暂时允许所有操作，后续可根据认证添加限制）
CREATE POLICY "Allow all operations on job_categories" ON job_categories FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "Allow all operations on jobs" ON jobs FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "Allow all operations on user_job_status" ON user_job_status FOR ALL USING (true) WITH CHECK (true);
CREATE POLICY "Allow all operations on mock_interview_sessions" ON mock_interview_sessions FOR ALL USING (true) WITH CHECK (true);

-- 创建索引优化查询
CREATE INDEX IF NOT EXISTS idx_jobs_category ON jobs(category_id);
CREATE INDEX IF NOT EXISTS idx_jobs_published_at ON jobs(published_at DESC);
CREATE INDEX IF NOT EXISTS idx_user_job_status_job ON user_job_status(job_id);
CREATE INDEX IF NOT EXISTS idx_user_job_status_user ON user_job_status(user_id);
CREATE INDEX IF NOT EXISTS idx_mock_interview_job ON mock_interview_sessions(job_id);

